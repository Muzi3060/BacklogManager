<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BacklogManager.Models"
        xmlns:controls="clr-namespace:BacklogManager.Controls"
        x:Class="BacklogManager.MainWindow"
        Title="Minhas Realizações" Width="1120" Height="780"
        MinWidth="900" MinHeight="660" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="TemplateDistribuicao" DataType="models:DistribuicaoDashboard">
            <Border Classes="card" Width="270" Padding="12" Margin="0,0,12,8"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Text="{Binding Nome}" /><TextBlock Grid.Column="1" Text="{Binding Quantidade}" FontWeight="Bold" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Percentual}" Maximum="100" Height="4" Margin="0,8,0,0" Foreground="{DynamicResource PanelAccent}" />
            </Grid></Border>
        </DataTemplate>
        <DataTemplate x:Key="TemplateEntradaDashboard" DataType="models:EntradaDashboard">
            <Button Classes="recent" Tag="{Binding}" Click="EditarDashboard_Click" HorizontalAlignment="Stretch" ToolTip.Tip="Abrir esta obra para editar" Margin="0,0,0,8">
                <Border Classes="card recenteCard" Padding="10"><Grid ColumnDefinitions="64,*">
                    <controls:CapaObra Endereco="{Binding Obra.Catalogo.CapaUrl}" Width="60" Height="64" Preenchimento="UniformToFill" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4">
                        <TextBlock Text="{Binding Obra.Catalogo.Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Obra.Catalogo.Titulo}" />
                        <TextBlock Text="{Binding Midia}" Classes="muted" />
                        <TextBlock Text="Dados simulados" IsVisible="{Binding Obra.Catalogo.Simulado}" Classes="muted" />
                        <TextBlock Text="{Binding Obra.StatusExibido}" Classes="muted" />
                        <TextBlock Text="{Binding Data}" Classes="muted" />
                        <TextBlock Text="{Binding Progresso}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid></Border>
            </Button>
        </DataTemplate>

        <StreamGeometry x:Key="HomeIcon">M3,10 L12,3 21,10 M5,9 V21 H10 V15 H14 V21 H19 V9</StreamGeometry>
        <StreamGeometry x:Key="LibraryIcon">M4,4 H9 V21 H4 Z M11,4 H16 V21 H11 Z M18,3 L22,20</StreamGeometry>
        <StreamGeometry x:Key="PlusIcon">M12,4 V20 M4,12 H20</StreamGeometry>
        <StreamGeometry x:Key="GameIcon">M7,6 H17 Q21,6 22,11 L23,17 Q23,21 20,20 L16,16 H8 L4,20 Q1,21 1,17 L2,11 Q3,6 7,6 Z M5,11 H11 M8,8 V14 M16,10 H17 M19,13 H20</StreamGeometry>
        <StreamGeometry x:Key="CheckIcon">M5,12 L10,17 20,6</StreamGeometry>
        <StreamGeometry x:Key="ArrowIcon">M4,12 H20 M14,6 L20,12 14,18</StreamGeometry>
        <DataTemplate x:Key="TemplateGrade" DataType="models:ItemBiblioteca">
            <Border Classes="card gameCard gradeCard" Width="180" Padding="10" Margin="0,0,10,0">
                <Grid RowDefinitions="Auto,14,18,14,16,18,14,14,14" RowSpacing="2">
                    <controls:CapaObra Grid.Row="0" Width="160" Classes="capaGrade" Endereco="{Binding Catalogo.CapaUrl}" Preenchimento="UniformToFill" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Height="14">
                        <Border Classes="indicadorSelecao" Height="3" Background="{DynamicResource SelectionBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                            <TextBlock Classes="textoSelecao" Text="✓ Selecionado" FontSize="10" Foreground="{DynamicResource SelectionText}" />
                            <TextBlock Classes="textoFoco" Text="Foco" FontSize="10" Foreground="{DynamicResource SelectionText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding Catalogo.Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Catalogo.Titulo}" />
                    <TextBlock Grid.Row="3" Text="{Binding GenerosExibidos}" ToolTip.Tip="{Binding GenerosExibidos}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="4" Text="{Binding StatusExibido}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusExibido}" FontSize="12" Classes="statusObra" />
                    <TextBlock Grid.Row="5" Text="{Binding Pessoal.Nota, StringFormat='★ {0:0.0}'}" Foreground="{DynamicResource WarningOnCard}" />
                    <TextBlock Grid.Row="6" Text="{Binding ProgressoExibido}" IsVisible="{Binding TemProgresso}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProgressoExibido}" />
                    <TextBlock Grid.Row="7" Text="{Binding Pessoal.Review}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Pessoal.Review}" />
                    <TextBlock Grid.Row="8" Text="Dados simulados" IsVisible="{Binding Catalogo.Simulado}" Foreground="{DynamicResource WarningOnCard}" FontSize="10" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TemplateLista" DataType="models:ItemBiblioteca">
            <Border Classes="card gameCard" Padding="12">
                <Grid ColumnDefinitions="64,*,58">
                    <controls:CapaObra Classes="capaLista" Endereco="{Binding Catalogo.CapaUrl}" Height="96" VerticalAlignment="Top" Preenchimento="UniformToFill" />
                    <StackPanel Grid.Column="1" Margin="12,0" Spacing="5">
                        <TextBlock Text="{Binding Catalogo.Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Catalogo.Titulo}" />
                        <TextBlock Text="{Binding GenerosExibidos}" ToolTip.Tip="{Binding GenerosExibidos}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusExibido}" Classes="statusObra" FontSize="12" />
                        <TextBlock Text="Dados simulados" IsVisible="{Binding Catalogo.Simulado}" Foreground="{DynamicResource WarningOnCard}" FontSize="11" />
                        <TextBlock Text="{Binding ProgressoExibido}" IsVisible="{Binding TemProgresso}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProgressoExibido}" />
                        <TextBlock Text="{Binding Pessoal.Review}" Classes="muted" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Pessoal.Review}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Pessoal.Nota, StringFormat='★ {0:0.0}'}" Foreground="{DynamicResource WarningOnCard}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Border.sidebar TextBlock.muted, Border.sidebar TextBlock.sectionLabel"><Setter Property="Foreground" Value="{DynamicResource SidebarMuted}" /></Style>
        <Style Selector="Border.gameCard"><Setter Property="CornerRadius" Value="8" /></Style>
        <Style Selector="Border.recenteCard"><Setter Property="CornerRadius" Value="8" /></Style>
        <Style Selector="Border.gradeCard">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.indicadorSelecao"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="TextBlock.textoSelecao"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="TextBlock.textoFoco"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="ListBox.obras ListBoxItem:selected Border.indicadorSelecao"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="ListBox.obras ListBoxItem:selected TextBlock.textoSelecao"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="ListBox.obras ListBoxItem:focus-visible Border.indicadorSelecao"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="ListBox.obras ListBoxItem:focus-visible TextBlock.textoFoco"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="ListBox.obras ListBoxItem:focus-visible Border.gameCard"><Setter Property="Background" Value="{DynamicResource CardBackground}" /></Style>
        <Style Selector="controls|CapaObra.capaGrade"><Setter Property="Height" Value="174" /></Style>
        <Style Selector="Window.compact controls|CapaObra.capaGrade"><Setter Property="Height" Value="104" /></Style>
        <Style Selector="Button.navigation">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarForeground}" />
            <Setter Property="Padding" Value="14,13" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.navigation:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource SidebarHoverText}" /><Setter Property="Background" Value="{DynamicResource SidebarHover}" />
        </Style>
        <Style Selector="Button.navigation.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
        </Style>
        <Style Selector="Button.navigation:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorder}" /><Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{DynamicResource SidebarBackground}" /><Setter Property="Foreground" Value="{DynamicResource SidebarForeground}" />
        </Style>
        <Style Selector="Button.recent">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.obras">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.obras ListBoxItem">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <ContentPresenter Name="PART_ContentPresenter" Background="Transparent" BorderThickness="0" CornerRadius="0"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="ListBox.obras ListBoxItem:pointerover Border.gameCard">
            <Setter Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
        </Style>
        <Style Selector="ListBox.obras ListBoxItem:selected Border.gameCard">
            <Setter Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        </Style>
        <!-- Os estados do tema têm precedência sobre valores definidos no template. -->
        <Style Selector="ListBox.obras ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.obras ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.obras ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border#AvisoOperacao">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="Background" Value="{DynamicResource SuccessBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border#IconeAviso">
            <Setter Property="Background" Value="{DynamicResource SuccessBackground}" />
        </Style>
        <Style Selector="TextBlock#TxtIconeAviso">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border#AvisoOperacao.erro">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="Background" Value="{DynamicResource ErrorBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
        </Style>
        <Style Selector="Border#AvisoOperacao.erro Border#IconeAviso">
            <Setter Property="Background" Value="{DynamicResource ErrorBackground}" />
        </Style>
        <Style Selector="Border#AvisoOperacao.erro TextBlock#TxtIconeAviso">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="202,*">
        <!-- A navegação permanece visível enquanto o conteúdo da página muda. -->
        <Border Classes="sidebar" TextElement.Foreground="{DynamicResource SidebarForeground}" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12,0">
                <Grid ColumnDefinitions="Auto,*" Margin="10,28,4,32">
                    <Border Background="{DynamicResource SidebarBackground}" CornerRadius="9" Width="32" Height="32">
                        <Path Data="{StaticResource GameIcon}" Stroke="{DynamicResource PanelAccent}" StrokeThickness="1.7" Width="21" Height="18" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Minhas Realizações" TextWrapping="Wrap" FontWeight="Bold" FontSize="16" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock Text="BIBLIOTECA" Classes="sectionLabel" Margin="14,0,0,10" />
                    <Button x:Name="NavInicio" Classes="navigation active" Tag="inicio" Click="Navegar_Click">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <Path Data="{StaticResource HomeIcon}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" />
                            <TextBlock Text="Início" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavBacklog" Classes="navigation" Tag="backlog" Click="Navegar_Click">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Path Data="{StaticResource LibraryIcon}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" />
                            <TextBlock Grid.Column="1" Text="Minha biblioteca" Margin="13,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="TxtContagemNav" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavColecoes" Classes="navigation" Tag="colecoes" Click="Navegar_Click">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <Path Data="{StaticResource LibraryIcon}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" />
                            <TextBlock Text="Coleções" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavCadastro" Classes="navigation" Tag="cadastro" Click="Navegar_Click">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <Path Data="{StaticResource PlusIcon}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" />
                            <TextBlock Text="Adicionar / editar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Grid.Row="3" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,8">
                    <Button x:Name="NavConfiguracoes" Classes="navigation" Tag="configuracoes" Click="Navegar_Click" Content="Configurações" AutomationProperties.Name="Abrir configurações" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="38,32,38,24">
            <!-- O aviso fica fora da rolagem e acompanha a navegação entre as páginas. -->
            <Border x:Name="AvisoOperacao" IsVisible="False" BorderThickness="1" CornerRadius="10"
                    Padding="16" Margin="0,0,0,20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border x:Name="IconeAviso" CornerRadius="18"
                            Width="36" Height="36" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtIconeAviso" Text="✓" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="5" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAvisoTitulo" FontSize="15" FontWeight="Bold" />
                        <TextBlock x:Name="TxtAvisoMensagem" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="×" Click="FecharAviso_Click"
                            AutomationProperties.Name="Fechar aviso" ToolTip.Tip="Fechar aviso"
                            Foreground="{DynamicResource ControlForeground}" FontSize="22" Padding="8,2"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <!-- INÍCIO: estatísticas locais, sem consultas de catálogo. -->
                <ScrollViewer x:Name="PaginaInicio" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="{Binding #PaginaInicio.Viewport.Width}" Margin="0,0,16,0" Spacing="20">
                        <TextBlock Text="Bem-vindo à sua biblioteca" Classes="pageTitle" TextWrapping="Wrap" />
                        <Border x:Name="FalhaDashboard" Classes="card" IsVisible="False">
                            <TextBlock Text="Não foi possível carregar a biblioteca. Estatísticas indisponíveis; o arquivo original foi preservado." TextWrapping="Wrap" />
                        </Border>
                        <StackPanel x:Name="ConteudoDashboard" Spacing="20">
                            <TextBlock Text="Resumo atual da biblioteca" FontSize="18" FontWeight="SemiBold" />
                            <WrapPanel>
                                <Border Classes="card" Width="132" MinHeight="110" Margin="0,0,10,10" Padding="14"><StackPanel Spacing="8"><TextBlock x:Name="TxtTotal" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PanelAccent}" /><TextBlock Text="Obras na coleção" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Classes="card" Width="132" MinHeight="110" Margin="0,0,10,10" Padding="14"><StackPanel Spacing="8"><TextBlock x:Name="TxtJogando" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PanelAccent}" /><TextBlock Text="Em andamento" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Classes="card" Width="132" MinHeight="110" Margin="0,0,10,10" Padding="14"><StackPanel Spacing="8"><TextBlock x:Name="TxtZerados" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PanelAccent}" /><TextBlock Text="Concluídas" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Classes="card" Width="132" MinHeight="110" Margin="0,0,10,10" Padding="14"><StackPanel Spacing="8"><TextBlock x:Name="TxtNaFilaDashboard" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PanelAccent}" /><TextBlock Text="Na fila" TextWrapping="Wrap" /></StackPanel></Border>
                            </WrapPanel>
                            <Border Classes="card"><StackPanel Spacing="10">
                                <TextBlock Text="Progresso da biblioteca" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock x:Name="TxtProgresso" />
                                <ProgressBar x:Name="ProgressoBacklog" Minimum="0" Maximum="100" Height="6" Foreground="{DynamicResource PanelAccent}" />
                                <TextBlock x:Name="TxtResumo" TextWrapping="Wrap" />
                            </StackPanel></Border>
                            <TextBlock Text="Distribuição por mídia" FontWeight="SemiBold" FontSize="18" />
                            <ItemsControl x:Name="DistribuicaoMidias" ItemTemplate="{StaticResource TemplateDistribuicao}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                            <TextBlock Text="Distribuição por status" FontWeight="SemiBold" FontSize="18" />
                            <ItemsControl x:Name="DistribuicaoStatus" ItemTemplate="{StaticResource TemplateDistribuicao}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                            <Border Classes="card"><StackPanel Spacing="12">
                                <TextBlock Text="Atividade recente — adições à biblioteca" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <ComboBox x:Name="CmbPeriodoDashboard" SelectedIndex="1" SelectionChanged="PeriodoDashboard_Changed" AutomationProperties.Name="Período da atividade recente">
                                    <ComboBoxItem Content="Últimos 7 dias" /><ComboBoxItem Content="Últimos 30 dias" />
                                </ComboBox>
                                <TextBlock x:Name="TxtPeriodoDashboard" TextWrapping="Wrap" />
                                <TextBlock x:Name="TxtAdicionadas" FontWeight="Bold" FontSize="26" />
                                <TextBlock x:Name="TxtAtividadeVazia" Text="Nenhuma adição com data conhecida neste período." TextWrapping="Wrap" />
                                <ItemsControl x:Name="ListaAtividade" ItemTemplate="{StaticResource TemplateEntradaDashboard}" />
                            </StackPanel></Border>
                            <TextBlock Text="Continue de onde parou" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtContinuarVazio" Text="Nenhuma obra em andamento." />
                            <ItemsControl x:Name="ListaContinuar" ItemTemplate="{StaticResource TemplateEntradaDashboard}" />
                            <Border x:Name="EstadoInicioVazio" Classes="card" IsVisible="False"><TextBlock Text="Sua coleção começa aqui. Adicione sua primeira obra!" Classes="muted" TextWrapping="Wrap" /></Border>
                            <WrapPanel>
                                <Button Content="Ver biblioteca" Tag="backlog" Click="Navegar_Click" Margin="0,0,10,10" />
                                <Button Content="Adicionar obra" Click="NovoJogo_Click" Margin="0,0,0,10" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- MEU BACKLOG -->
                <Grid x:Name="PaginaBacklog" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
                        <StackPanel Spacing="7">
                            <TextBlock Text="Minha biblioteca" Classes="pageTitle" />
                            <TextBlock Text="Suas obras, separadas por tipo de mídia." Classes="muted" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+  Adicionar obra" Classes="primary" Click="NovoJogo_Click" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="150,*,140" Margin="0,0,0,12">
                        <StackPanel Spacing="5" Margin="0,0,10,0">
                            <TextBlock Text="Tipo de mídia" Classes="muted" FontSize="12" />
                            <ComboBox x:Name="CmbTipoBiblioteca" SelectedIndex="0" SelectionChanged="TipoBiblioteca_Changed">
                                <ComboBoxItem Content="Jogos" Tag="Jogo" /><ComboBoxItem Content="Animes" Tag="Anime" />
                                <ComboBoxItem Content="Séries" Tag="Serie" /><ComboBoxItem Content="Filmes" Tag="Filme" />
                                <ComboBoxItem Content="Mangás" Tag="Manga" /><ComboBoxItem Content="Livros" Tag="Livro" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5" Margin="0,0,10,0">
                            <TextBlock Text="Ordenação" Classes="muted" FontSize="12" />
                            <ComboBox x:Name="CmbOrdenacao" SelectedIndex="0" SelectionChanged="Filtros_Changed">
                                <ComboBoxItem Content="Ordem de cadastro" /><ComboBoxItem Content="Título A–Z" />
                                <ComboBoxItem Content="Título Z–A" /><ComboBoxItem Content="Maior nota" />
                                <ComboBoxItem Content="Menor nota" /><ComboBoxItem Content="Adição recente" /><ComboBoxItem Content="Adição antiga" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="Visualização" Classes="muted" FontSize="12" />
                            <ComboBox x:Name="CmbVisualizacao" SelectedIndex="0" SelectionChanged="Visualizacao_Changed">
                                <ComboBoxItem Content="Grade" /><ComboBoxItem Content="Lista" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,180">
                            <TextBox x:Name="TxtBusca" PlaceholderText="Buscar por título ou categoria..." TextChanged="Filtros_Changed" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1" x:Name="CmbFiltroStatus" SelectedIndex="0" SelectionChanged="Filtros_Changed">
                                <ComboBoxItem Content="Todos os status" /><ComboBoxItem Content="Na Fila" /><ComboBoxItem Content="Jogando" />
                                <ComboBoxItem Content="Zerado" /><ComboBoxItem Content="Pausado" /><ComboBoxItem Content="Abandonado" />
                            </ComboBox>
                        </Grid>
                        <Expander x:Name="FiltrosAvancados" Header="Mais filtros" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel>
                                    <StackPanel Width="170" Margin="0,0,10,8" Spacing="4">
                                        <TextBlock Text="Gênero / categoria legada" FontSize="11" Classes="muted" />
                                        <ComboBox x:Name="CmbGenero" SelectionChanged="Filtros_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="170" Margin="0,0,10,8" Spacing="4">
                                        <TextBlock Text="Plataforma (se disponível)" FontSize="11" Classes="muted" />
                                        <ComboBox x:Name="CmbPlataforma" SelectionChanged="Filtros_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="0,0,10,8" Spacing="4">
                                        <TextBlock Text="Nota mínima" FontSize="11" Classes="muted" />
                                        <NumericUpDown x:Name="NumNotaMinima" Minimum="0" Maximum="5" Increment="0.5" ValueChanged="NotaFiltro_Changed" PlaceholderText="Todas" />
                                    </StackPanel>
                                    <StackPanel Width="170" Margin="0,0,10,8" Spacing="4">
                                        <TextBlock Text="Adicionada de (data local)" FontSize="11" Classes="muted" />
                                        <CalendarDatePicker x:Name="DataAdicaoDe" SelectedDateChanged="DataFiltro_Changed" PlaceholderText="Qualquer data" />
                                    </StackPanel>
                                    <StackPanel Width="170" Margin="0,0,10,8" Spacing="4">
                                        <TextBlock Text="Adicionada até (data local)" FontSize="11" Classes="muted" />
                                        <CalendarDatePicker x:Name="DataAdicaoAte" SelectedDateChanged="DataFiltro_Changed" PlaceholderText="Qualquer data" />
                                    </StackPanel>
                                    <Button x:Name="BtnLimparFiltros" Content="Limpar filtros" Click="LimparFiltros_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                                </WrapPanel>
                            </ScrollViewer>
                        </Expander>
                        <TextBlock x:Name="TxtErroFiltros" IsVisible="False" TextWrapping="Wrap" Foreground="{DynamicResource WarningOnPage}" FontSize="11" />
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <ListBox x:Name="ListaBacklog" Classes="obras" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListaBacklog_SelectionChanged">

                        </ListBox>
                        <StackPanel x:Name="EstadoListaVazia" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="20">
                            <Path Data="{StaticResource LibraryIcon}" Stroke="{DynamicResource PanelAccent}" StrokeThickness="1.4" Width="32" Height="32" Stretch="Uniform" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtListaVazia" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtDicaListaVazia" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="4" BorderBrush="{DynamicResource PageBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock x:Name="TxtContagemLista" Classes="muted" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Grid.Column="1" x:Name="BtnEditar" Content="Editar jogo" Click="EditarSelecionado_Click" IsEnabled="False" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" x:Name="BtnRemover" Content="Remover" Classes="danger" Click="BtnRemover_Click" IsEnabled="False" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- COLEÇÕES PESSOAIS: não dependem das categorias de mídia. -->
                <ScrollViewer x:Name="PaginaColecoes" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" MaxWidth="900">
                        <TextBlock Text="Minhas coleções" Classes="pageTitle" />
                        <TextBlock Text="Organize obras de qualquer mídia. Uma obra pode participar de várias coleções." Classes="muted" TextWrapping="Wrap" />
                        <Border x:Name="AvisoColecoesIndisponiveis" IsVisible="False" Classes="card">
                            <TextBlock x:Name="TxtFalhaColecoes" TextWrapping="Wrap" Foreground="{DynamicResource ErrorOnPanel}" />
                        </Border>
                        <TextBlock Text="Coleção" FontWeight="SemiBold" />
                        <ComboBox x:Name="CmbColecoes" SelectionChanged="Colecao_Changed" PlaceholderText="Crie ou selecione uma coleção">
                            <ComboBox.ItemTemplate><DataTemplate DataType="models:ColecaoPersonalizada"><TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Nome da coleção" FontWeight="SemiBold" />
                        <TextBox x:Name="TxtNomeColecao" MaxLength="120" PlaceholderText="Ex.: Meus favoritos" />
                        <TextBlock Text="Descrição (opcional)" Classes="muted" />
                        <TextBox x:Name="TxtDescricaoColecao" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1000" Height="64" PlaceholderText="Como você quer organizar esta coleção?" />
                        <WrapPanel>
                            <Button x:Name="BtnNovaColecao" Content="Nova coleção" Click="NovaColecao_Click" Margin="0,0,8,8" />
                            <Button x:Name="BtnCriarColecao" Content="Criar coleção" Classes="primary" Click="CriarColecao_Click" Margin="0,0,8,8" />
                            <Button x:Name="BtnSalvarColecao" Content="Salvar alterações" Click="SalvarColecao_Click" Margin="0,0,8,8" />
                            <Button x:Name="BtnExcluirColecao" Content="Excluir coleção" Classes="danger" Click="ExcluirColecao_Click" Margin="0,0,0,8" />
                        </WrapPanel>
                        <Border x:Name="ConfirmacaoExclusaoColecao" IsVisible="False" Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="TxtConfirmacaoColecao" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button x:Name="BtnConfirmarExcluirColecao" Content="Confirmar exclusão" Classes="danger" Click="ConfirmarExcluirColecao_Click" Margin="0,0,8,0" />
                                    <Button x:Name="BtnCancelarExcluirColecao" Content="Cancelar" Click="CancelarExcluirColecao_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Adicionar obra existente" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox x:Name="CmbObraColecao" SelectionChanged="ObraColecao_Changed" PlaceholderText="Selecione uma obra da biblioteca" Margin="0,0,10,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:ItemBiblioteca">
                                        <StackPanel Spacing="2" ToolTip.Tip="{Binding Pessoal.Review}">
                                            <TextBlock Text="{Binding Catalogo.Titulo}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Catalogo.Tipo}" Classes="muted" FontSize="11" />
                                                <TextBlock Text="{Binding StatusExibido}" Classes="muted" FontSize="11" />
                                                <TextBlock Text="{Binding Pessoal.Nota, StringFormat='★ {0:0.0}'}" Classes="avisoPainel" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" x:Name="BtnAdicionarObraColecao" Content="Adicionar à coleção" Click="AdicionarObraColecao_Click" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="TxtResumoColecao" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtColecaoVazia" Text="Selecione ou crie uma coleção para ver suas obras." Classes="muted" TextWrapping="Wrap" />
                        <ListBox x:Name="ListaObrasColecao" Classes="obras" Height="220" ItemTemplate="{StaticResource TemplateLista}" SelectionChanged="ObraColecao_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        <WrapPanel>
                            <Button x:Name="BtnEditarObraColecao" Content="Editar dados pessoais" Click="EditarObraColecao_Click" Margin="0,0,8,12" />
                            <Button x:Name="BtnRemoverObraColecao" Content="Remover da coleção" Click="RemoverObraColecao_Click" Margin="0,0,0,12" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PaginaConfiguracoes" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Margin="0,0,16,16" MaxWidth="{Binding #PaginaConfiguracoes.Viewport.Width}">
                        <TextBlock Text="Configurações" Classes="pageTitle" />
                        <Border Classes="card" Padding="16"><StackPanel Spacing="10">
                            <TextBlock Text="Sobre e atualizações" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtVersaoAplicativo" />
                            <TextBlock x:Name="TxtEstadoAtualizacao" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <WrapPanel><Button x:Name="BtnVerificarAtualizacoes" Content="Verificar atualizações" Click="VerificarAtualizacoes_Click" Margin="0,0,12,12" />
                            <Button x:Name="BtnAbrirAtualizacao" Content="Abrir página oficial para download" Click="AbrirAtualizacao_Click" IsVisible="False" Margin="0,0,0,12" /></WrapPanel>
                        </StackPanel></Border>
                        <Border x:Name="PreferenciasVisuais" Classes="card" Padding="16"><StackPanel Spacing="10">
                            <TextBlock Text="Aparência" FontSize="18" FontWeight="SemiBold" />
                            <WrapPanel>
                                <StackPanel Width="220" Margin="0,0,12,12" Spacing="6">
                                    <TextBlock Text="Tema" />
                                    <ComboBox x:Name="CmbTema" SelectionChanged="TemaAparencia_Changed" AutomationProperties.Name="Tema visual">
                                        <ComboBoxItem Content="Moderno" /><ComboBoxItem Content="Tecnológico" /><ComboBoxItem Content="Acolhedor" /><ComboBoxItem Content="Dark Mode" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,0,12" Spacing="6">
                                    <TextBlock Text="Modo" />
                                    <ComboBox x:Name="CmbModo" SelectionChanged="TemaAparencia_Changed" AutomationProperties.Name="Modo claro ou escuro">
                                        <ComboBoxItem Content="Claro" /><ComboBoxItem Content="Escuro" />
                                    </ComboBox>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock x:Name="TxtEstadoAparencia" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="BtnRepetirSalvarAparencia" Content="Tentar salvar novamente" IsVisible="False" Click="RepetirSalvarAparencia_Click" />
                        </StackPanel></Border>
                        <Border Classes="card" Padding="16"><StackPanel Spacing="10">
                            <TextBlock Text="Armazenamento local ativo" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Os caminhos abaixo correspondem à sessão atual. Exportar um backup não muda a pasta da biblioteca." Classes="muted" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtCaminhosDados" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel></Border>
                        <Border Classes="card" Padding="16"><StackPanel Spacing="12">
                            <TextBlock Text="Backup local" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Um único JSON inclui biblioteca e coleções. Capas permanecem como referências. Guarde o arquivo em um local seguro: ele contém suas informações pessoais e não é criptografado." TextWrapping="Wrap" />
                            <CheckBox x:Name="ChkIncluirPreferencias" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource PanelForeground}" Content="Incluir aparência e visualização na exportação" IsChecked="True" />
                            <WrapPanel>
                                <Button x:Name="BtnExportarBackup" Content="Exportar backup" Click="ExportarBackup_Click" Margin="0,0,10,10" />
                                <Button x:Name="BtnSelecionarBackup" Content="Selecionar e validar backup" Click="SelecionarBackup_Click" Margin="0,0,0,10" />
                            </WrapPanel>
                            <TextBlock x:Name="TxtEstadoBackup" Text="Nenhuma restauração iniciada." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="BtnRecuperarBackup" Content="Tentar recuperação pendente" Click="RecuperarBackup_Click" IsVisible="False" />
                            <Border x:Name="PreviaBackup" Classes="card" Padding="12" IsVisible="False"><StackPanel Spacing="12">
                                <TextBlock Text="Prévia da substituição" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtPreviaBackup" TextWrapping="Wrap" />
                                <CheckBox x:Name="ChkRestaurarPreferencias" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource PanelForeground}" IsCheckedChanged="PreferenciasBackup_Changed"><TextBlock Text="Restaurar também as preferências disponíveis (substitui as atuais)" TextWrapping="Wrap" /></CheckBox>
                                <TextBlock Text="Antes da escrita será criado e verificado um backup externo do estado atual. Se isso falhar, a restauração será cancelada. A substituição de vários arquivos não é uma transação atômica; falhas podem exigir recuperação." Classes="muted" TextWrapping="Wrap" />
                                <CheckBox x:Name="ChkConfirmarSubstituicao" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource PanelForeground}" IsCheckedChanged="ConfirmacaoBackup_Changed"><TextBlock Text="Confirmo que a biblioteca e as coleções atuais serão substituídas pelo backup selecionado." TextWrapping="Wrap" /></CheckBox>
                                <WrapPanel>
                                    <Button x:Name="BtnConfirmarBackup" Content="Substituir dados atuais" Click="ConfirmarBackup_Click" IsEnabled="False" Margin="0,0,10,10" />
                                    <Button x:Name="BtnCancelarBackup" Content="Cancelar" Click="CancelarBackup_Click" Margin="0,0,0,10" />
                                </WrapPanel>
                            </StackPanel></Border>
                        </StackPanel></Border>
                        <Border Classes="card" Padding="16"><StackPanel Spacing="8">
                            <TextBlock Text="Recursos futuros" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtRecursosFuturos" Text="Nuvem, sincronização, modo híbrido e Google Drive ainda não estão disponíveis. O armazenamento e o backup desta fase são exclusivamente locais." Classes="muted" TextWrapping="Wrap" />
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- CADASTRO / EDIÇÃO -->
                <ScrollViewer x:Name="PaginaCadastro" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="7">
                            <TextBlock x:Name="TxtTituloCadastro" Text="Adicionar jogo" Classes="pageTitle" />
                            <TextBlock x:Name="TxtSubtituloCadastro" Text="Uma nova aventura para a sua coleção." Classes="muted" />
                        </StackPanel>
                        <Border Classes="card" Padding="24">
                            <StackPanel Spacing="18">
                                <TextBlock Text="DADOS DA OBRA" Classes="sectionLabel" />
                                <StackPanel Spacing="7">
                                    <TextBlock Text="Tipo de mídia" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbTipoCadastro" SelectedIndex="0" SelectionChanged="TipoCadastro_Changed">
                            <ComboBoxItem Content="Jogos" Tag="Jogo" />
                            <ComboBoxItem Content="Animes" Tag="Anime" />
                            <ComboBoxItem Content="Séries" Tag="Serie" />
                            <ComboBoxItem Content="Filmes" Tag="Filme" />
                            <ComboBoxItem Content="Mangás" Tag="Manga" />
                            <ComboBoxItem Content="Livros" Tag="Livro" />
                        </ComboBox>
                                </StackPanel>
                                <Border x:Name="AvisoCatalogoSimulado" IsVisible="False" TextElement.Foreground="{DynamicResource WarningBrush}" Background="{DynamicResource WarningBackground}" CornerRadius="6" Padding="12">
                                    <TextBlock Text="Catálogo de demonstração: os resultados desta categoria são simulados." TextWrapping="Wrap" />
                                </Border>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Título" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtTitulo" PlaceholderText="Ex.: Cyberpunk 2077" TextChanged="TxtTitulo_TextChanged"/>
                                    <ListBox x:Name="ListaSugestoes" SelectionChanged="ListaSugestoes_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="models:ObraCatalogo">
                                                <Grid ColumnDefinitions="44,*" MinHeight="64">
                                                    <controls:CapaObra Endereco="{Binding CapaUrl}" Height="60" />
                                                    <StackPanel Grid.Column="1" Spacing="3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding GenerosTexto}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="Dados simulados" IsVisible="{Binding Simulado}" Classes="avisoPainel" FontSize="11" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel x:Name="CampoCategoriaLegada" Spacing="8" Margin="0,0,16,0">
                                        <TextBlock Text="Categoria pessoal" FontWeight="SemiBold" />
                                        <ComboBox x:Name="CmbCategoria" SelectedIndex="0">
                                            <ComboBoxItem Content="RPG" />
                                            <ComboBoxItem Content="Ação / Aventura" />
                                            <ComboBoxItem Content="FPS / Tiro" />
                                            <ComboBoxItem Content="Estratégia" />
                                            <ComboBoxItem Content="Indie" />
                                            <ComboBoxItem Content="Outro" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel x:Name="CampoGenerosCatalogo" Spacing="8" Margin="0,0,16,0">
                                        <TextBlock Text="Gêneros do catálogo" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtGenerosCatalogo" TextWrapping="Wrap" Classes="muted" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Status" FontWeight="SemiBold" />
                                        <ComboBox x:Name="CmbStatus" SelectedIndex="0">
                                            <ComboBoxItem Content="Na Fila" />
                                            <ComboBoxItem Content="Jogando" />
                                            <ComboBoxItem Content="Zerado" />
                                            <ComboBoxItem Content="Pausado" />
                                            <ComboBoxItem Content="Abandonado" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Sua nota" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="160,*">
                                        <NumericUpDown x:Name="NumNota" Minimum="0" Maximum="5" Increment="0.5" FormatString="0.0" Value="5.0" />
                                        <TextBlock Grid.Column="1" Text="De 0 a 5 estrelas" Classes="muted" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Progresso pessoal (opcional)" FontWeight="SemiBold" />
                                    <StackPanel x:Name="ProgressoJogo" IsVisible="False" Spacing="7">
                                        <TextBlock Text="Horas jogadas" Classes="muted" />
                                        <NumericUpDown x:Name="NumHorasJogadas" Minimum="0" Maximum="79228162514264337593543950335" Increment="0.5" FormatString="0.##" />
                                    </StackPanel>
                                    <StackPanel x:Name="ProgressoAnime" IsVisible="False" Spacing="7">
                                        <TextBlock Text="Episódios assistidos" Classes="muted" />
                                        <NumericUpDown x:Name="NumEpisodiosAssistidos" Minimum="0" Maximum="2147483647" Increment="1" FormatString="0" />
                                    </StackPanel>
                                    <StackPanel x:Name="ProgressoSerie" IsVisible="False" Spacing="7">
                                        <TextBlock Text="Temporada" Classes="muted" />
                                        <NumericUpDown x:Name="NumTemporada" Minimum="0" Maximum="2147483647" Increment="1" FormatString="0" />
                                        <TextBlock Text="Episódio" Classes="muted" />
                                        <NumericUpDown x:Name="NumEpisodio" Minimum="0" Maximum="2147483647" Increment="1" FormatString="0" />
                                    </StackPanel>
                                    <StackPanel x:Name="ProgressoFilme" IsVisible="False" Spacing="7">
                                        <TextBlock Text="Minutos assistidos" Classes="muted" />
                                        <NumericUpDown x:Name="NumMinutosAssistidos" Minimum="0" Maximum="79228162514264337593543950335" Increment="0.5" FormatString="0.##" />
                                    </StackPanel>
                                    <StackPanel x:Name="ProgressoManga" IsVisible="False" Spacing="7">
                                        <TextBlock Text="Capítulo" Classes="muted" />
                                        <controls:PosicaoNumerica x:Name="NumCapituloManga" />
                                        <TextBlock Text="Volume" Classes="muted" />
                                        <controls:PosicaoNumerica x:Name="NumVolume" />
                                    </StackPanel>
                                    <StackPanel x:Name="ProgressoLivro" IsVisible="False" Spacing="7">
                                        <TextBlock Text="Página" Classes="muted" />
                                        <controls:PosicaoNumerica x:Name="NumPagina" />
                                        <TextBlock Text="Capítulo" Classes="muted" />
                                        <controls:PosicaoNumerica x:Name="NumCapituloLivro" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Review / comentários" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Opcional · até 1000 caracteres" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBox x:Name="TxtReview" PlaceholderText="O que você achou da obra? Registre suas impressões..." AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1000" Height="120" VerticalContentAlignment="Top" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <Button Grid.Column="1" Content="Limpar / novo" Click="LimparFormulario_Click" Margin="0,0,12,0" />
                            <Button Grid.Column="2" x:Name="BtnAdicionar" Classes="primary" Content="Adicionar jogo" Click="BtnAdicionar_Click" />
                            <Button Grid.Column="2" x:Name="BtnAtualizar" Classes="primary" Content="Salvar alterações" Click="BtnAtualizar_Click" IsVisible="False" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
