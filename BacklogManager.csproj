<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Title>Minhas Realizações</Title>
    <Product>Minhas Realizações</Product>
    <Nullable>enable</Nullable>
    <Version>0.1.0-beta.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.1</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PythonExecutable Condition="'$(PythonExecutable)' == '' and '$(OS)' == 'Windows_NT'">python</PythonExecutable>
    <PythonExecutable Condition="'$(PythonExecutable)' == ''">python3</PythonExecutable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <Compile Remove="Tests/**/*.cs" />
    <AvaloniaResource Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NuGet.Versioning" Version="6.14.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(BetaDistribution)' == 'true'">
    <AssemblyMetadata Include="RepositorioReleases" Value="$(RepositorioReleases)" Condition="'$(RepositorioReleases)' != ''" />
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)beta/$(RuntimeIdentifier)/igdb.json" LogicalName="MinhasRealizacoes.Beta.Igdb" />
  </ItemGroup>
  <Target Name="PrepararCredenciaisBeta" BeforeTargets="PrepareForBuild" Condition="'$(BetaDistribution)' == 'true'">
    <Exec Command="&quot;$(PythonExecutable)&quot; &quot;$(MSBuildProjectDirectory)/scripts/preparar_credenciais_beta.py&quot; --destino &quot;$(BaseIntermediateOutputPath)beta/$(RuntimeIdentifier)/igdb.json&quot;" />
  </Target>
</Project>
